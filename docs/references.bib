@inproceedings{holler2020hddl,
  author    = {H{\"o}ller, Daniel and Behnke, Gregor and Bercher, Pascal and
               Biundo, Susanne and Fiorino, Humbert and Pellier, Damien and
               Alford, Ron},
  title     = {{HDDL}: An Extension to {PDDL} for Expressing Hierarchical
               Planning Problems},
  booktitle = {Proceedings of the AAAI Conference on Artificial Intelligence},
  volume    = {34},
  pages     = {9883--9891},
  year      = {2020},
  doi       = {10.1609/aaai.v34i06.6542},
  annote    = {Defines HDDL, the input language of the planner. Cite it whenever
               the accepted input format or its semantics are described.
               Used throughout src/parsing/ (the JSON AST mirrors the HDDL
               grammar), in the README requirements, and in tests/ipc.rs, which
               runs the IPC HDDL benchmarks.}
}

@techreport{mcdermott1998pddl,
